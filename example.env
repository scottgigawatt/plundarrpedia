#
# .env file: Environment variables for Plundarrpedia image builds and Docker
#            Compose deployment.
#

#
# Name of the project which adds a namespace for services and resources.
#
COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME:-plundarrpedia}

#
# Default healthcheck timing settings.
#
DEFAULT_HEALTHCHECK_INTERVAL="${DEFAULT_HEALTHCHECK_INTERVAL:-30s}"
DEFAULT_HEALTHCHECK_TIMEOUT="${DEFAULT_HEALTHCHECK_TIMEOUT:-5s}"
DEFAULT_HEALTHCHECK_START_PERIOD="${DEFAULT_HEALTHCHECK_START_PERIOD:-10s}"
DEFAULT_HEALTHCHECK_RETRIES="${DEFAULT_HEALTHCHECK_RETRIES:-3}"

#
# Plundarrpedia image, build, port, and resource variables.
#
PLUNDARRPEDIA_IMAGE_REF="${PLUNDARRPEDIA_IMAGE_REF:-ghcr.io/scottgigawatt/plundarrpedia}"
PLUNDARRPEDIA_TAG="${PLUNDARRPEDIA_TAG:-edge}"
PLUNDARRPEDIA_HOST_PORT="${PLUNDARRPEDIA_HOST_PORT:-8000}"
PLUNDARRPEDIA_MEM_LIMIT="${PLUNDARRPEDIA_MEM_LIMIT:-256m}"
PLUNDARRPEDIA_CPU_SHARES="${PLUNDARRPEDIA_CPU_SHARES:-512}"

#
# Local authoring and generated static-site variables.
#
MKDOCS_AUTHOR_PORT="${MKDOCS_AUTHOR_PORT:-8000}"
SITE_OUTPUT_PATH="${SITE_OUTPUT_PATH:-site}"

#
# Docker build context and Dockerfile variables shared by Compose and Buildx.
#
DOCKER_BUILD_CONTEXT="${DOCKER_BUILD_CONTEXT:-.}"
DOCKERFILE="${DOCKERFILE:-docker/Dockerfile}"

#
# Pinned build-stage and runtime image variables.
#
MKDOCS_MATERIAL_IMAGE="${MKDOCS_MATERIAL_IMAGE:-squidfunk/mkdocs-material}"
MKDOCS_MATERIAL_TAG="${MKDOCS_MATERIAL_TAG:-9.8.0@sha256:dc3b5de76c6e30d18dc0922d4c4a7bed817e5e155f9ff0e594a53eb56e537e64}"
NGINX_UNPRIVILEGED_IMAGE="${NGINX_UNPRIVILEGED_IMAGE:-nginxinc/nginx-unprivileged}"
NGINX_UNPRIVILEGED_TAG="${NGINX_UNPRIVILEGED_TAG:-1.31.7-alpine3.24@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e}"

#
# Open Container Initiative image metadata variables.
#
IMAGE_CREATED="${IMAGE_CREATED:-unknown}"
IMAGE_REVISION="${IMAGE_REVISION:-unknown}"
IMAGE_VERSION="${IMAGE_VERSION:-edge}"
