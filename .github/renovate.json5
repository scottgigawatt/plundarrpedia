{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'config:recommended',
        'helpers:pinGitHubActionDigests',
        ':enablePreCommit',
    ],
    timezone: 'America/New_York',
    schedule: [
        '* 0-7 1 * *',
    ],
    automergeSchedule: [
        '* 0-7 1 * *',
    ],
    updateNotScheduled: false,
    prConcurrentLimit: 2,
    dependencyDashboard: {
        enabled: true,
    },
    automerge: true,
    automergeType: 'pr',
    automergeStrategy: 'squash',
    platformAutomerge: false,
    rebaseWhen: 'behind-base-branch',
    labels: [
        'dependencies',
    ],
    assignees: [
        'scottgigawatt',
    ],
    reviewers: [
        'scottgigawatt',
    ],
    enabledManagers: [
        'custom.regex',
        'docker-compose',
        'dockerfile',
        'github-actions',
        'pip_requirements',
        'pre-commit',
    ],
    customManagers: [
        {
            customType: 'regex',
            managerFilePatterns: [
                '/^example\\.env$/',
            ],
            matchStrings: [
                'MKDOCS_MATERIAL_TAG="\\$\\{MKDOCS_MATERIAL_TAG:-(?<currentValue>[^@\\s}]+)@(?<currentDigest>sha256:[a-f0-9]+)\\}"',
            ],
            depNameTemplate: 'squidfunk/mkdocs-material',
            datasourceTemplate: 'docker',
            versioningTemplate: 'docker',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '/^example\\.env$/',
            ],
            matchStrings: [
                'NGINX_UNPRIVILEGED_TAG="\\$\\{NGINX_UNPRIVILEGED_TAG:-(?<currentValue>[^@\\s}]+)@(?<currentDigest>sha256:[a-f0-9]+)\\}"',
            ],
            depNameTemplate: 'nginxinc/nginx-unprivileged',
            datasourceTemplate: 'docker',
            versioningTemplate: 'docker',
        },
    ],
    packageRules: [
        {
            groupName: 'pre-commit hooks',
            matchManagers: [
                'pre-commit',
            ],
        },
        {
            matchManagers: [
                'docker-compose',
                'dockerfile',
                'custom.regex',
            ],
            pinDigests: true,
        },
        {
            groupName: 'GitHub Actions',
            matchManagers: [
                'github-actions',
            ],
        },
        {
            groupName: 'Container images',
            matchManagers: [
                'custom.regex',
                'docker-compose',
                'dockerfile',
            ],
        },
        {
            groupName: 'MkDocs dependencies',
            matchManagers: [
                'pip_requirements',
            ],
        },
        {
            matchUpdateTypes: [
                'minor',
                'patch',
                'pin',
                'digest',
            ],
            groupName: 'monthly maintenance',
        },
        {
            matchDatasources: [
                'docker',
            ],
            schedule: [
                '* 0-7 * * 1',
            ],
            automergeSchedule: [
                '* 0-7 * * 1',
            ],
            groupName: 'weekly production dependencies',
        },
        {
            matchUpdateTypes: [
                'major',
            ],
            dependencyDashboardApproval: true,
            automerge: false,
            groupName: null,
        },
    ],
    vulnerabilityAlerts: {
        enabled: true,
        dependencyDashboardApproval: false,
        groupName: null,
        automerge: false,
        schedule: [
            'at any time',
        ],
        automergeSchedule: [
            'at any time',
        ],
        updateNotScheduled: true,
    },
}
