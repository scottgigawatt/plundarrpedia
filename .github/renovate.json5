//
// renovate.json5: Automated update policy for actions, Python dependencies,
//                 Compose images, and Dockerfile base images.
//

{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        ":enablePreCommit"
    ],
    "timezone": "America/New_York",
    "schedule": ["before 8am on monday"],
    "dependencyDashboard": true,

    // Merge dependency PRs after required checks pass; keep branches current.
    "automerge": true,
    "automergeType": "pr",
    "automergeStrategy": "squash",
    "platformAutomerge": true,
    "rebaseWhen": "behind-base-branch",
    "labels": ["dependencies"],
    "assignees": ["scottgigawatt"],
    "reviewers": ["scottgigawatt"],
    "enabledManagers": [
        "custom.regex",
        "docker-compose",
        "dockerfile",
        "github-actions",
        "pip_requirements",
        "pre-commit"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/^example\\.env$/"],
            "matchStrings": [
                "MKDOCS_MATERIAL_TAG=\"\\$\\{MKDOCS_MATERIAL_TAG:-(?<currentValue>[^@\\s}]+)@(?<currentDigest>sha256:[a-f0-9]+)\\}\""
            ],
            "depNameTemplate": "squidfunk/mkdocs-material",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/^example\\.env$/"],
            "matchStrings": [
                "NGINX_UNPRIVILEGED_TAG=\"\\$\\{NGINX_UNPRIVILEGED_TAG:-(?<currentValue>[^@\\s}]+)@(?<currentDigest>sha256:[a-f0-9]+)\\}\""
            ],
            "depNameTemplate": "nginxinc/nginx-unprivileged",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "groupName": "pre-commit hooks",
            "matchManagers": ["pre-commit"]
        },
        {
            "matchManagers": ["docker-compose", "dockerfile", "custom.regex"],
            "pinDigests": true
        },
        {
            "groupName": "GitHub Actions",
            "matchManagers": ["github-actions"]
        },
        {
            "groupName": "Container images",
            "matchManagers": ["custom.regex", "docker-compose", "dockerfile"]
        },
        {
            "groupName": "MkDocs dependencies",
            "matchManagers": ["pip_requirements"]
        }
    ]
}
